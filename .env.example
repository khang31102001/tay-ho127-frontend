# Base URL của Backend ASP.NET Core Web API cho các lời gọi từ Site (client
# mặc định `api` trong src/lib/http/api-client.ts). Để trống => gọi tương đối
# trên chính origin hiện tại (Route Handler mock /api/*).
NEXT_PUBLIC_API_URL=

# Origin của Backend ASP.NET Core mà Admin Portal gọi qua BFF
# (app/api/admin/*, src/lib/auth/admin-backend-session.ts). SERVER-ONLY —
# không bao giờ lộ ra trình duyệt. Bắt buộc để đăng nhập Admin.
# Local: http://localhost:5140
BACKEND_API_URL=http://localhost:5140

# Host ảnh ngoài (CDN chứa file của Thư viện Media), phân cách dấu phẩy, vd.
# cdn.tayho127.vn,res.cloudinary.com. Dùng cho <Image /> (next.config.mjs) và để
# chỉ cho chọn vào nội dung Site những ảnh hiển thị được. Để trống = chỉ ảnh /public.
NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=
